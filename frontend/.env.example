# Drishti AI Frontend Environment Configuration Template
# Only prefix variables with VITE_ to expose them to client-side code

# In local development: leave blank to use the Vite proxy (http://localhost:5000)
# In production (Vercel): set to your deployed backend URL (e.g. https://drishti-ai-backend-emau.onrender.com)
VITE_API_BASE_URL=https://drishti-ai-backend-emau.onrender.com
